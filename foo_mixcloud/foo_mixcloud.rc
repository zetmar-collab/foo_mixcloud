#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_MIXCLOUD_PREFERENCES DIALOGEX 0, 0, 340, 200
STYLE DS_SETFONT | WS_CHILD
FONT 8, "Microsoft Sans Serif", 400, 0, 0x0
BEGIN
    LTEXT           "yt-dlp executable (path or name on PATH):",IDC_STATIC,8,8,220,8
    EDITTEXT        IDC_YTDLP_PATH,8,18,260,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_YTDLP_BROWSE,272,18,60,12

    LTEXT           "Mixcloud account login (used to access private / favorited shows):",IDC_STATIC,8,40,320,8

    CONTROL         "No login (public content only)",IDC_COOKIE_NONE,"Button",BS_AUTORADIOBUTTON | WS_GROUP,8,54,220,10
    CONTROL         "Use cookies exported from browser (cookies.txt file):",IDC_COOKIE_FILE,"Button",BS_AUTORADIOBUTTON,8,68,260,10
    EDITTEXT        IDC_COOKIE_FILE_PATH,20,80,250,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...",IDC_COOKIE_FILE_BROWSE,272,80,60,12

    CONTROL         "Read cookies directly from a browser:",IDC_COOKIE_BROWSER,"Button",BS_AUTORADIOBUTTON,8,98,260,10
    LTEXT           "Browser name (chrome, firefox, edge, brave, vivaldi, opera):",IDC_STATIC,20,110,220,8
    EDITTEXT        IDC_COOKIE_BROWSER_NAME,20,120,120,12,ES_AUTOHSCROLL

    LTEXT           "yt-dlp audio format selector:",IDC_STATIC,8,142,220,8
    EDITTEXT        IDC_FORMAT_SELECTOR,8,152,180,12,ES_AUTOHSCROLL

    LTEXT           "Tip: use 'Mixcloud > Add user's uploads...' from the main menu to load shows from an account.",IDC_STATIC,8,176,320,16
END

IDD_MIXCLOUD_INPUT DIALOGEX 0, 0, 280, 70
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Mixcloud"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_INPUT_PROMPT,8,8,264,16
    EDITTEXT        IDC_INPUT_EDIT,8,28,264,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,166,48,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,222,48,50,14
END
